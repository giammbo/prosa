# Prosa reads these from the environment (copy to .env and `set -a; . ./.env; set +a`).

# --- Planner (LLM) ---
# Backend: anthropic (default) or openai (any OpenAI-compatible endpoint; needs --model or PROSA_MODEL).
PROSA_LLM=anthropic
# Anthropic credentials (or sign in with `ant auth login`).
ANTHROPIC_API_KEY=
# Only for PROSA_LLM=openai: endpoint and key (e.g. a local Ollama or vLLM server).
PROSA_LLM_BASE_URL=
PROSA_LLM_API_KEY=
# Model and reasoning effort for planning, and for the per-environment patch.
PROSA_MODEL=
PROSA_PATCH_MODEL=
PROSA_EFFORT=
PROSA_PATCH_EFFORT=
# Cap on provider schema bytes sent to the model (useful for small local models).
PROSA_SCHEMA_BYTES=

# --- State ---
# Passphrase of the client-side encrypted state store. Required, keep it safe: without it the state cannot be read.
PROSA_STATE_PASSPHRASE=

# --- AWS ---
# Region and endpoint override (take precedence over AWS_REGION and the AWS profile).
PROSA_AWS_REGION=eu-south-1
# Point at an emulator such as Moto (http://localhost:5555); leave empty for real AWS.
PROSA_AWS_ENDPOINT=
# Set to 1 to refuse to run unless PROSA_AWS_ENDPOINT is set (never touch real AWS by mistake).
PROSA_REQUIRE_ENDPOINT=
