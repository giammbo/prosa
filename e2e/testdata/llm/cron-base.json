              },
              {
                "key": "job.logs",
                "type": "aws_cloudwatch_log_group",
                "config": {
                  "name": "/ecs/clearsessions",
                  "retention_in_days": 30
                }
              },
              {
                "key": "job.execution_role",
                "type": "aws_iam_role",
                "config": {
                  "assume_role_policy": {
                    "Statement": [
                      {
                        "Action": "sts:AssumeRole",
                        "Effect": "Allow",
                        "Principal": {
                          "Service": "ecs-tasks.amazonaws.com"
                        }
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "description": "Lets ECS start the clearsessions task and read the database secret",
                  "name": "clearsessions-execution"
                }
              },
              {
                "key": "job.execution_role_policy",
                "type": "aws_iam_role_policy",
                "config": {
                  "name": "read-database-secret",
                  "policy": {
                    "Statement": [
                      {
                        "Action": "secretsmanager:GetSecretValue",
                        "Effect": "Allow",
                        "Resource": "${database/db.instance.master_user_secret.0.secret_arn}"
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "role": "${cron/job.execution_role.name}"
                }
              },
              {
                "key": "job.execution_role_logs",
                "type": "aws_iam_role_policy",
                "config": {
                  "name": "write-logs",
                  "policy": {
                    "Statement": [
                      {
                        "Action": [
                          "logs:CreateLogStream",
                          "logs:PutLogEvents"
                        ],
                        "Effect": "Allow",
                        "Resource": "${cron/job.logs.arn}:*"
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "role": "${cron/job.execution_role.name}"
                }
              },
              {
                "key": "job.task_role",
                "type": "aws_iam_role",
                "config": {
                  "assume_role_policy": {
                    "Statement": [
                      {
                        "Action": "sts:AssumeRole",
                        "Effect": "Allow",
                        "Principal": {
                          "Service": "ecs-tasks.amazonaws.com"
                        }
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "description": "Role of the clearsessions container, for the application's own permissions",
                  "name": "clearsessions-task"
                }
              },
              {
                "key": "job.task",
                "type": "aws_ecs_task_definition",
                "config": {
                  "container_definitions": [
                    {
                      "command": [
                        "python",
                        "manage.py",
                        "clearsessions"
                      ],
                      "essential": true,
                      "image": "ghcr.io/acme/web:1.4.2",
                      "logConfiguration": {
                        "logDriver": "awslogs",
                        "options": {
                          "awslogs-group": "${cron/job.logs.name}",
                          "awslogs-region": "eu-south-1",
                          "awslogs-stream-prefix": "clearsessions"
                        }
                      },
                      "name": "clearsessions",
                      "secrets": [
                        {
                          "name": "DATABASE_URL",
                          "valueFrom": "${database/db.instance.master_user_secret.0.secret_arn}"
                        }
                      ]
                    }
                  ],
                  "cpu": "256",
                  "execution_role_arn": "${cron/job.execution_role.arn}",
                  "family": "clearsessions",
                  "memory": "512",
                  "network_mode": "awsvpc",
                  "requires_compatibilities": [
                    "FARGATE"
                  ],
                  "task_role_arn": "${cron/job.task_role.arn}"
                }
              },
              {
                "key": "job.scheduler_role",
                "type": "aws_iam_role",
                "config": {
                  "assume_role_policy": {
                    "Statement": [
                      {
                        "Action": "sts:AssumeRole",
                        "Effect": "Allow",
                        "Principal": {
                          "Service": "scheduler.amazonaws.com"
                        }
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "description": "Lets EventBridge Scheduler run the clearsessions task",
                  "name": "clearsessions-scheduler"
                }
              },
              {
                "key": "job.scheduler_role_policy",
                "type": "aws_iam_role_policy",
                "config": {
                  "name": "run-clearsessions",
                  "policy": {
                    "Statement": [
                      {
                        "Action": "ecs:RunTask",
                        "Condition": {
                          "ArnEquals": {
                            "ecs:cluster": "${cron/job.cluster.arn}"
                          }
                        },
                        "Effect": "Allow",
                        "Resource": "${cron/job.task.arn}"
                      },
                      {
                        "Action": "iam:PassRole",
                        "Effect": "Allow",
                        "Resource": [
                          "${cron/job.execution_role.arn}",
                          "${cron/job.task_role.arn}"
                        ]
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "role": "${cron/job.scheduler_role.name}"
                }
              },
              {
                "key": "job.schedule",
                "type": "aws_scheduler_schedule",
                "config": {
                  "description": "python manage.py clearsessions every night at 03:00, Rome time",
                  "flexible_time_window": [
                    {
                      "mode": "off"
                    }
                  ],
                  "name": "clearsessions",
                  "schedule_expression": "cron(0 3 * * ? *)",
                  "schedule_expression_timezone": "Europe/Rome",
                  "state": "ENABLED",
                  "target": [
                    {
                      "arn": "${cron/job.cluster.arn}",
                      "ecs_parameters": [
                        {
                          "launch_type": "FARGATE",
                          "network_configuration": [
                            {
                              "assign_public_ip": false,
                              "security_groups": [
                                "${database/net.app_sg.id}"
                              ],
                              "subnets": [
                                "${database/net.subnet_private_a.id}",
                                "${database/net.subnet_private_b.id}"
                              ]
                            }
                          ],
                          "task_count": 1,
                          "task_definition_arn": "${cron/job.task.arn}"
                        }
                      ],
                      "role_arn": "${cron/job.scheduler_role.arn}"
                    }
                  ]
                }
              },
              {
                "key": "alerts.topic",
                "type": "aws_sns_topic",
                "config": {
                  "name": "platform-alerts"
                }
              },
              {
                "key": "alerts.failed_runs",
                "type": "aws_cloudwatch_event_rule",
                "config": {
                  "description": "A clearsessions task stopped with a non-zero exit code",
                  "event_pattern": {
                    "detail": {
                      "clusterArn": [
                        "${cron/job.cluster.arn}"
                      ],
                      "containers": {
                        "exitCode": [
                          {
                            "anything-but": 0
