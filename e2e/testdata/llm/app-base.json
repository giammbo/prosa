              {
                "key": "app.execution_role",
                "type": "aws_iam_role",
                "config": {
                  "assume_role_policy": {
                    "Statement": [
                      {
                        "Action": "sts:AssumeRole",
                        "Effect": "Allow",
                        "Principal": {
                          "Service": "ecs-tasks.amazonaws.com"
