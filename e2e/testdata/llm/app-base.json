                    ],
                    "Version": "2012-10-17"
                  },
                  "role": "${app/app.execution_role.name}"
                }
              },
              {
                "key": "app.execution_role_logs",
                "type": "aws_iam_role_policy",
                "config": {
                  "name": "write-logs",
                  "policy": {
                    "Statement": [
                      {
                        "Action": [
                          "logs:CreateLogStream",
                          "logs:PutLogEvents"
                        ],
                        "Effect": "Allow",
                        "Resource": "${app/app.logs.arn}:*"
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "role": "${app/app.execution_role.name}"
                }
              },
              {
                "key": "app.task_role",
                "type": "aws_iam_role",
                "config": {
                  "assume_role_policy": {
                    "Statement": [
                      {
                        "Action": "sts:AssumeRole",
                        "Effect": "Allow",
                        "Principal": {
                          "Service": "ecs-tasks.amazonaws.com"
                        }
                      }
                    ],
                    "Version": "2012-10-17"
                  },
                  "description": "Role of the web app containers, for the application's own permissions",
                  "name": "web-task",
                  "tags": {
                    "team": "platform"
                  }
                }
              },
              {
                "key": "app.task",
                "type": "aws_ecs_task_definition",
                "config": {
                  "container_definitions": [
                    {
                      "essential": true,
                      "image": "ghcr.io/acme/web:1.4.2",
                      "logConfiguration": {
                        "logDriver": "awslogs",
                        "options": {
                          "awslogs-group": "${app/app.logs.name}",
                          "awslogs-region": "eu-south-1",
                          "awslogs-stream-prefix": "web"
                        }
                      },
                      "name": "web",
                      "portMappings": [
                        {
                          "containerPort": 8000,
                          "protocol": "tcp"
                        }
                      ],
                      "secrets": [
                        {
                          "name": "DATABASE_URL",
                          "valueFrom": "${database/db.instance.master_user_secret.0.secret_arn}"
                        }
                      ]
                    }
                  ],
                  "cpu": "256",
                  "execution_role_arn": "${app/app.execution_role.arn}",
                  "family": "web",
                  "memory": "512",
                  "network_mode": "awsvpc",
                  "requires_compatibilities": [
                    "FARGATE"
                  ],
                  "tags": {
                    "team": "platform"
                  },
                  "task_role_arn": "${app/app.task_role.arn}"
                }
              },
              {
                "key": "app.alb_sg",
                "type": "aws_security_group",
                "config": {
                  "description": "Public load balancer of the web app",
                  "name": "web-alb",
                  "tags": {
                    "team": "platform"
                  },
                  "vpc_id": "${database/net.vpc.id}"
                }
              },
              {
                "key": "app.alb_sg_https",
                "type": "aws_vpc_security_group_ingress_rule",
                "config": {
                  "cidr_ipv4": "0.0.0.0/0",
                  "description": "HTTPS from the internet",
                  "from_port": 443,
                  "ip_protocol": "tcp",
                  "security_group_id": "${app/app.alb_sg.id}",
                  "tags": {
                    "team": "platform"
                  },
                  "to_port": 443
                }
              },
              {
                "key": "app.alb_sg_to_app",
                "type": "aws_vpc_security_group_egress_rule",
                "config": {
                  "cidr_ipv4": "${database/net.vpc.cidr_block}",
                  "description": "To the web app containers, in the VPC",
                  "from_port": 8000,
                  "ip_protocol": "tcp",
                  "security_group_id": "${app/app.alb_sg.id}",
                  "tags": {
                    "team": "platform"
                  },
                  "to_port": 8000
                }
              },
              {
                "key": "app.app_sg_from_alb",
                "type": "aws_vpc_security_group_ingress_rule",
                "config": {
                  "cidr_ipv4": "${database/net.vpc.cidr_block}",
                  "description": "Web app traffic from the load balancer, in the VPC",
                  "from_port": 8000,
                  "ip_protocol": "tcp",
                  "security_group_id": "${database/net.app_sg.id}",
                  "tags": {
                    "team": "platform"
                  },
                  "to_port": 8000
                }
              },
              {
                "key": "app.alb",
                "type": "aws_lb",
                "config": {
                  "internal": false,
                  "load_balancer_type": "application",
                  "name": "web",
                  "security_groups": [
                    "${app/app.alb_sg.id}"
                  ],
                  "subnets": [
                    "${database/net.subnet_public_a.id}",
                    "${database/net.subnet_public_b.id}"
                  ],
                  "tags": {
                    "team": "platform"
                  }
                }
              },
              {
                "key": "app.target_group",
                "type": "aws_lb_target_group",
                "config": {
                  "health_check": {
                    "matcher": "200",
                    "path": "/health"
                  },
                  "name": "web",
                  "port": 8000,
                  "protocol": "HTTP",
                  "tags": {
                    "team": "platform"
                  },
                  "target_type": "ip",
                  "vpc_id": "${database/net.vpc.id}"
                }
              },
              {
                "key": "app.certificate",
                "type": "aws_acm_certificate",
                "config": {
                  "domain_name": "app.acme.example",
                  "tags": {
                    "team": "platform"
                  },
                  "validation_method": "DNS"
                }
              },
              {
                "key": "app.certificate_validation",
                "type": "aws_acm_certificate_validation",
                "config": {
                  "certificate_arn": "${app/app.certificate.arn}"
                }
              },
              {
                "key": "app.listener_https",
                "type": "aws_lb_listener",
                "config": {
                  "certificate_arn": "${app/app.certificate_validation.certificate_arn}",
                  "default_action": [
                    {
                      "target_group_arn": "${app/app.target_group.arn}",
                      "type": "forward"
                    }
                  ],
                  "load_balancer_arn": "${app/app.alb.arn}",
                  "port": 443,
                  "protocol": "HTTPS",
                  "ssl_policy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
                  "tags": {
                    "team": "platform"
                  }
                }
              },
              {
                "key": "app.service",
                "type": "aws_ecs_service",
                "config": {
                  "cluster": "${app/app.cluster.arn}",
                  "desired_count": 1,
                  "launch_type": "fargate",
                  "load_balancer": [
                    {
                      "container_name": "web",
                      "container_port": 8000,
                      "target_group_arn": "${app/app.target_group.arn}"
                    }
                  ],
                  "name": "web",
                  "network_configuration": [
                    {
                      "assign_public_ip": false,
                      "security_groups": [
                        "${database/net.app_sg.id}"
                      ],
                      "subnets": [
                        "${database/net.subnet_private_a.id}",
                        "${database/net.subnet_private_b.id}"
                      ]
                    }
                  ],
                  "tags": {
                    "Name": "${app/app.cluster.name}-svc",
                    "team": "platform"
                  },
                  "task_definition": "${app/app.task.arn}"
                },
                "depends_on": [
                  "app/app.listener_https"
                ]
              }
            ],
            "checks": [
              {
                "name": "`/health` on the web app's domain answers 200 within 60 seconds of the end of the apply.",
                "type": "http_get",
                "url": "https://app.acme.example/health",
                "status": 200,
                "within": "60s"
              },
              {
                "name": "The certificate is valid for more than 20 days.",
                "type": "tls_days",
                "host": "app.acme.example",
                "min_days": 20
              },
              {
                "name": "The number of healthy replicas at rest is the requested one.",
                "type": "resource_attr",
                "resource": "app/app.service",
                "path": "desired_count",
                "op": "eq",
                "value": 1
              }
            ]
          }
        }
